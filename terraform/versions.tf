# Keep CLI and provider versions in a supported range.
# Commit the dependency lock file generated by terraform init.
terraform {
  required_version = ">= 1.10.0, < 2.0.0"

  backend "s3" {
    key = "event-intelligence/prod/terraform.tfstate"
    region = "eu-central-1"
    encrypt = true
    use_locakfile = true
  }

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 6.0"
    }
  }
}
